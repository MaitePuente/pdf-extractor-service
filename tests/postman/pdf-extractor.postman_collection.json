{
  "info": {
    "name": "PDF Extractor API",
    "description": "Seleccionar manualmente el PDF binario externo en la solicitud de extracción válida. El puerto de Traefik es dinámico: ajustar base_url. El caso 429 requiere saturación controlada y se documenta aparte.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {"name": "Health legacy", "request": {"method": "GET", "url": "{{base_url}}/health"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('health 200', () => pm.response.to.have.status(200));", "pm.test('legacy contract', () => pm.expect(pm.response.json()).to.eql({status:'ok',service:'extractor'}));", "pm.test('request id', () => pm.expect(pm.response.headers.get('X-Request-ID')).to.be.a('string').and.not.empty);"]}}]},
    {"name": "Liveness", "request": {"method": "GET", "url": "{{base_url}}/health/live"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('live 200', () => pm.response.to.have.status(200));", "pm.test('service name', () => pm.expect(pm.response.json().service).to.eql('pdf-extractor'));"]}}]},
    {"name": "Readiness", "request": {"method": "GET", "url": "{{base_url}}/health/ready"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('ready or degraded according to policy', () => pm.expect([200,503]).to.include(pm.response.code));", "pm.test('dependency field', () => pm.expect(pm.response.json().dependencies.redis).to.be.oneOf(['ok','unavailable','unknown']));"]}}]},
    {"name": "Swagger (DOCS_ENABLED=true)", "request": {"method": "GET", "url": "{{base_url}}/docs"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('docs enabled', () => pm.response.to.have.status(200));"]}}]},
    {"name": "Extract valid PDF - choose external binary file", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/pdf"}, {"key": "X-Request-ID", "value": "postman-valid-1"}], "body": {"mode": "file", "file": {"src": ""}}, "url": "{{base_url}}/extract", "description": "En Postman Body > binary elegir uno de los PDFs oficiales, o pdf279hojas.pdf. Para el PDF de 279 páginas, expected_page_count=279."}, "event": [{"listen": "test", "script": {"exec": ["pm.test('extract 200', () => pm.response.to.have.status(200));", "pm.test('JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));", "pm.test('page count', () => pm.expect(pm.response.json().page_count).to.eql(Number(pm.environment.get('expected_page_count'))));", "pm.test('Markdown non-empty', () => pm.expect(pm.response.json().content).to.be.a('string').and.not.empty);", "pm.test('cache state', () => pm.expect(pm.response.headers.get('X-Cache')).to.be.oneOf(['HIT','MISS','ERROR','BYPASS']));", "pm.test('request id echoed', () => pm.expect(pm.response.headers.get('X-Request-ID')).to.eql('postman-valid-1'));"]}}]},
    {"name": "Invalid PDF", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/pdf"}], "body": {"mode": "raw", "raw": "not a PDF"}, "url": "{{base_url}}/extract"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('400', () => pm.response.to.have.status(400));", "pm.test('Problem Details', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json'));", "pm.test('request id in problem', () => pm.expect(pm.response.json().request_id).to.eql(pm.response.headers.get('X-Request-ID')));"]}}]},
    {"name": "Wrong Content-Type", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "text/plain"}], "body": {"mode": "raw", "raw": "bad"}, "url": "{{base_url}}/extract"}, "event": [{"listen": "test", "script": {"exec": ["pm.test('415', () => pm.response.to.have.status(415));", "pm.test('Problem Details', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json'));"]}}]},
    {"name": "Oversize PDF - select a file larger than 20 MiB", "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/pdf"}], "body": {"mode": "file", "file": {"src": ""}}, "url": "{{base_url}}/extract", "description": "Requiere seleccionar manualmente un archivo de prueba mayor a MAX_UPLOAD_MB. Postman no incluye el PDF ni genera 21 MiB por defecto."}, "event": [{"listen": "test", "script": {"exec": ["pm.test('413', () => pm.response.to.have.status(413));", "pm.test('Problem Details', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json'));"]}}]}
  ]
}
