+def convert_shared(name: str, size: int):
+    memory = SharedMemory(name=name)
+    try:
+        # PyMuPDF's bytes API does not accept memoryview. This copy remains;
+        # only the name and size, rather than the full PDF, travel over IPC.
+        body = bytes(memory.buf[:size])
+    finally:
+        memory.close()
+    return convert_in_process(body)
